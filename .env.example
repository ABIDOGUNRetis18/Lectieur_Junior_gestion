# Base de données Neon (PostgreSQL)
# DATABASE_URL : adresse AVEC pooling (hôte contenant « -pooler ») — utilisée par l'app
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# DIRECT_URL : adresse SANS pooling — utilisée par prisma migrate
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Secret Auth.js (générer avec: openssl rand -base64 32)
AUTH_SECRET="change-me-in-production"

# URL publique de l'app
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="https://lecteurs-juniors.vercel.app"

# Envoi d'e-mails (OTP) — optionnel
# Si non défini, le code OTP est loggé dans la console (mode dev)
#
# Option 1 : SMTP (Gmail, Outlook, serveur mail perso, etc.)
# Pour Gmail : créez un mot de passe d'application sur https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
# 465 = TLS direct (recommandé pour Gmail) ; 587 = STARTTLS
SMTP_PORT="465"
SMTP_USER="lecteursjuniors@gmail.com"
SMTP_PASS="votre-mot-de-passe-d-application"
SMTP_FROM="Lecteurs Juniors <lecteursjuniors@gmail.com>"
#
# Option 2 : Resend (https://resend.com) — décommenter et remplir
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="Lecteurs Juniors <noreply@votre-domaine.com>"
