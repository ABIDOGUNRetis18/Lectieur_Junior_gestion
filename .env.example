# Base de données Neon (PostgreSQL)
# DATABASE_URL : adresse AVEC pooling (hôte contenant « -pooler ») — utilisée par l'app
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# DIRECT_URL : adresse SANS pooling — utilisée par prisma migrate
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Secret Auth.js (générer avec: openssl rand -base64 32)
AUTH_SECRET="change-me-in-production"

# URL publique de l'app
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="https://lecteurs-juniors.vercel.app"
